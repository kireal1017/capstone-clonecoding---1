{
  "name": "@planmate/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js --config eslint.config.mjs . --max-warnings=0",
    "test": "node ../node_modules/vitest/vitest.mjs run",
    "prisma:generate": "node ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ../node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node ../node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "node ../node_modules/prisma/build/index.js studio",
    "db:seed": "node ../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "prisma": {
    "seed": "node ../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "express-async-errors": "^3.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "zod": "^3.23.0",
    "multer": "^1.4.5-lts.1",
    "morgan": "^1.10.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.0",
    "express-rate-limit": "^7.0.0",
    "dotenv": "^16.4.0",
    "@prisma/client": "^5.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "prisma": "^5.18.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/multer": "^1.4.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0"
  }
}
